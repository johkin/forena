# syntax=docker/dockerfile:1
# Context: backend/api/. Native executable extracted from the CI-tested image.
# Paketo uses Ubuntu Noble; keep a compatible glibc runtime.
FROM --platform=linux/amd64 ubuntu:24.04
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libstdc++6 zlib1g && rm -rf /var/lib/apt/lists/*
WORKDIR /app
# No JDK or JAR is included in the release image.
COPY --chown=10001:10001 --chmod=0555 target/forena-api /app/forena-api
RUN ldd /app/forena-api > /tmp/native-libraries && ! grep -q "not found" /tmp/native-libraries && rm /tmp/native-libraries
COPY --chown=10001:10001 target/supabase-ca.crt /app/supabase-ca.crt
COPY --chmod=0555 scripts/container-entrypoint.sh /entrypoint.sh
USER 10001:10001
ENV PORT=80
EXPOSE 80
ENTRYPOINT ["sh", "/entrypoint.sh"]
