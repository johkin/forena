# New React/Kotlin app: Spring-managed accounts, PostgreSQL provider independent.
FORENA_WEB_ORIGIN=https://forena-kotlin.vercel.app
FORENA_PASSKEY_RP_ID=forena-kotlin.vercel.app
# Supply FORENA_WEB_SESSION_KEY (base64, 32 bytes), RESEND_API_KEY and
# RESEND_FROM_EMAIL through runtime secret settings, never the frontend build.
# JDBC uses verify-full and the trusted database CA, with separate credentials:
# FORENA_JDBC_URL, FORENA_DB_USERNAME, FORENA_DB_PASSWORD
# FORENA_MIGRATION_USERNAME, FORENA_MIGRATION_PASSWORD
# The local Spring profile needs none of these external settings.
# M06/M10 remains disabled until an isolated test is configured. Token is backend-only.
FORENA_NOTIFICATIONS_ENABLED=false
# FORENA_NOTIFICATION_WORKER_TOKEN: separate secret, at least 32 characters
# FORENA_NOTIFICATION_TEST_RECIPIENTS: comma-separated verified synthetic account addresses
