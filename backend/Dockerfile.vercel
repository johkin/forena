# syntax=docker/dockerfile:1
# Build context: backend/
# Local proxy CA: docker build --secret id=proxy_ca,src="$CODEX_PROXY_CERT" -f Dockerfile.vercel .
FROM --platform=linux/amd64 debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587 AS jdk

# Oracle archive bytes match the locally verified JDK 26.0.2.1+1-7.
# Never substitute latest or another patch without verifying its exact bytes.
RUN --mount=type=secret,id=proxy_ca,required=false \
    --mount=type=tmpfs,target=/tmp <<'SH'
set -eu
apt-get update
apt-get install -y --no-install-recommends ca-certificates curl libstdc++6 zlib1g
rm -rf /var/lib/apt/lists/*
cat /etc/ssl/certs/ca-certificates.crt > /tmp/download-ca.pem
if [ -f /run/secrets/proxy_ca ]; then
    cat /run/secrets/proxy_ca >> /tmp/download-ca.pem
fi
curl --fail --show-error --location --cacert /tmp/download-ca.pem \
    https://download.oracle.com/java/26/archive/jdk-26.0.2.1_linux-x64_bin.tar.gz \
    --output /tmp/jdk.tar.gz
printf '%s  %s\n' \
    30410726d866e16154571879785a44736009bc34e409cb66473b6e797d883df7 \
    /tmp/jdk.tar.gz | sha256sum --check --strict
mkdir -p /opt/java
tar -xzf /tmp/jdk.tar.gz --strip-components=1 -C /opt/java
/opt/java/bin/java --version
SH

ENV JAVA_HOME=/opt/java
ENV PATH="/opt/java/bin:${PATH}"

FROM jdk AS builder
WORKDIR /build
COPY .mvn/ .mvn/
COPY mvnw pom.xml ./
COPY src/ src/
RUN --mount=type=secret,id=proxy_ca,required=false \
    --mount=type=tmpfs,target=/tmp \
    --mount=type=cache,target=/root/.m2 <<'SH'
set -eu
# The wrapper checksum pins the ZIP, so prevent its tar.gz fallback.
apt-get update
apt-get install -y --no-install-recommends unzip
rm -rf /var/lib/apt/lists/*
# Extend the ordinary roots only for this RUN; no proxy CA enters runtime.
cat /etc/ssl/certs/ca-certificates.crt > /tmp/download-ca.pem
cp "$JAVA_HOME/lib/security/cacerts" /tmp/maven-cacerts
if [ -f /run/secrets/proxy_ca ]; then
    cat /run/secrets/proxy_ca >> /tmp/download-ca.pem
    keytool -importcert -noprompt -alias build-proxy-ca \
        -file /run/secrets/proxy_ca -keystore /tmp/maven-cacerts \
        -storepass changeit
fi
export CURL_CA_BUNDLE=/tmp/download-ca.pem
export MAVEN_OPTS="${MAVEN_OPTS:-} -Djavax.net.ssl.trustStore=/tmp/maven-cacerts -Djavax.net.ssl.trustStorePassword=changeit"
# Maven requires explicit proxy settings; Docker supplies its normal proxy args.
printf '<settings><proxies>' > /tmp/maven-settings.xml
build_proxy="${HTTPS_PROXY:-${https_proxy:-${HTTP_PROXY:-${http_proxy:-}}}}"
if [ -n "$build_proxy" ]; then
    case "$build_proxy" in
        http://*) build_proxy="${build_proxy#http://}" ;;
        *) echo 'Build requires an HTTP CONNECT proxy URL' >&2; exit 1 ;;
    esac
    build_proxy="${build_proxy%/}"
    case "$build_proxy" in
        *'@'*|*'/'*|*'<'*|*'>'*|*'&'*) echo 'Unsupported build proxy authority' >&2; exit 1 ;;
    esac
    proxy_host="${build_proxy%%:*}"
    proxy_port="${build_proxy##*:}"
    [ "$proxy_port" != "$build_proxy" ] || proxy_port=80
    case "$proxy_port" in ''|*[!0-9]*) exit 1 ;; esac
    printf '<proxy><id>build</id><active>true</active><protocol>http</protocol><host>%s</host><port>%s</port><nonProxyHosts>localhost|127.0.0.1</nonProxyHosts></proxy>' \
        "$proxy_host" "$proxy_port" >> /tmp/maven-settings.xml
fi
printf '</proxies></settings>\n' >> /tmp/maven-settings.xml
chmod +x mvnw
./mvnw --settings /tmp/maven-settings.xml --batch-mode --no-transfer-progress -DskipTests package
SH

FROM jdk AS runtime
WORKDIR /app
COPY --from=builder --chown=10001:10001 /build/target/forena-kotlin-probe.jar /app/forena-kotlin-probe.jar
COPY --chown=10001:10001 certs/supabase-ca.crt /app/supabase-ca.crt
USER 10001:10001
ENV PORT=80
EXPOSE 80
ENTRYPOINT ["java", "-jar", "/app/forena-kotlin-probe.jar"]
