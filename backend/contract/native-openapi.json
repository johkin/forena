      },
      "PersonalTeam": {
        "properties": {
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "organization_id": {
            "format": "uuid",
            "type": "string"
          },
          "roles": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "id",
          "name",
          "organization_id",
          "roles"
        ],
        "type": "object"
      },
      "RespondToInvitationRequest": {
        "additionalProperties": false,
        "properties": {
          "comment": {
            "description": "Omitted preserves the comment; null or blank clears it. Trimmed and truncated to 500 Unicode code points. Pending always clears it.",
            "type": [
              "string",
              "null"
            ]
          },
          "response": {
            "enum": [
              "pending",
              "accepted",
              "declined"
            ],
            "type": "string"
          }
        },
        "required": [
          "response"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "cookie": {
        "description": "Opaque HttpOnly browser session; never a provider token.",
        "in": "cookie",
        "name": "__Host-forena-session",
        "type": "apiKey"
      }
    }
