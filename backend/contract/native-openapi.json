{
  "components": {
    "schemas": {
      "AccessibleInvitation": {
        "properties": {
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "person_id": {
            "format": "uuid",
            "type": "string"
          },
          "response": {
            "enum": [
              "pending",
              "accepted",
              "declined"
            ],
            "type": "string"
          },
          "response_comment": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "person_id",
          "response",
          "response_comment"
        ],
        "type": "object"
      },
      "ActivityPerson": {
        "properties": {
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "invitation": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/AccessibleInvitation"
              },
              {
                "type": "null"
              }
            ]
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "invitation",
          "name"
        ],
        "type": "object"
      },
      "ApiError": {
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "BrowserAuthAcknowledgement": {
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "type": "object"
      },
      "BrowserLoginRequest": {
        "properties": {
          "email": {
            "maxLength": 320,
            "minLength": 3,
            "type": "string"
          },
          "password": {
            "format": "password",
            "maxLength": 1024,
            "minLength": 1,
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "email",
          "password"
        ],
        "type": "object"
      },
      "BrowserSessionView": {
        "properties": {
          "user": {
            "$ref": "#/components/schemas/BrowserUser"
          }
        },
        "required": [
          "user"
        ],
        "type": "object"
      },
      "BrowserUser": {
        "properties": {
          "email": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "email",
          "id"
        ],
        "type": "object"
      },
      "InvitationResponseResult": {
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "type": "object"
      },
      "MagicLinkRequest": {
        "properties": {
          "email": {
            "format": "email",
            "maxLength": 320,
            "minLength": 3,
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "type": "object"
      },
      "MagicLinkVerifyRequest": {
        "properties": {
          "code": {
            "maxLength": 2048,
            "minLength": 1,
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "code"
        ],
        "type": "object"
      },
      "MyActivities": {
        "properties": {
          "activities": {
            "items": {
              "$ref": "#/components/schemas/MyActivity"
            },
            "type": "array"
          },
          "next_offset": {
            "format": "int32",
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "activities",
          "next_offset"
        ],
        "type": "object"
      },
      "MyActivity": {
        "properties": {
          "ends_at": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "invitations": {
            "items": {
              "$ref": "#/components/schemas/AccessibleInvitation"
            },
            "type": "array"
          },
          "organization_name": {
            "type": "string"
          },
          "starts_at": {
            "format": "date-time",
            "type": "string"
          },
          "team_name": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "ends_at",
          "id",
          "invitations",
          "organization_name",
          "starts_at",
          "team_name",
          "title"
        ],
        "type": "object"
      },
      "MyInvitations": {
        "properties": {
          "invitations": {
            "items": {
              "$ref": "#/components/schemas/AccessibleInvitation"
            },
            "type": "array"
          }
        },
        "required": [
          "invitations"
        ],
        "type": "object"
      },
      "NativeCodeRequest": {
        "properties": {
          "code": {
            "type": "string",
            "writeOnly": true
          }
        },
        "type": "object"
      },
      "NativeConsentView": {
        "properties": {
          "clientId": {
            "type": "string"
          },
          "clientName": {
            "type": "string"
          },
          "csrfParameter": {
            "type": "string"
          },
          "csrfToken": {
            "type": "string"
          },
          "resource": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "state": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "NativePasskeyView": {
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "NativeRegisterRequest": {
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
