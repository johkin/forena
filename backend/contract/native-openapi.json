  "info": {
    "title": "Förena activities API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/activities/{activityId}": {
      "get": {
        "description": "Activity details authorized through personal invitations, dated membership or own team access. Reading never grants response rights for another person. Unknown/unauthorized IDs return 404. No-store.",
        "operationId": "getPersonalActivity",
        "parameters": [
          {
            "in": "path",
            "name": "activityId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PersonalActivity"
                }
              }
            },
            "description": "OK"
          }
        },
        "tags": [
          "personal-overview-controller"
        ]
      }
    },
    "/api/activities/{activityId}/my-invitations": {
      "get": {
        "description": "Only own people and active guardian links. Future invitations return an empty list. Cache-Control: no-store.",
        "operationId": "getMyInvitations",
        "parameters": [
          {
            "in": "path",
            "name": "activityId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MyInvitations"
                }
              }
            },
            "description": "Accessible invitations"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Invalid activity UUID"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Missing, invalid, locally inactive or provider-inactive web session"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Activity unavailable to account"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Current Auth session cannot be verified; no fallback"
          }
        },
        "tags": [
          "invitation-controller"
        ]
      }
    },
    "/api/auth/continue": {
      "get": {
        "operationId": "resume",
