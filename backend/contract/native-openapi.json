          }
        },
        "required": [
          "challenge_id",
          "credential"
        ],
        "type": "object"
      },
      "PersonalActivity": {
        "properties": {
          "description": {
            "type": "string"
          },
          "ends_at": {
            "format": "date-time",
            "type": "string"
          },
          "gathering_at": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "organization": {
            "$ref": "#/components/schemas/PersonalOrganization"
          },
          "people": {
            "items": {
              "$ref": "#/components/schemas/ActivityPerson"
            },
            "type": "array"
          },
          "response_due_at": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "starts_at": {
            "format": "date-time",
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "team": {
            "$ref": "#/components/schemas/PersonalTeam"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "description",
          "ends_at",
          "gathering_at",
          "id",
          "location",
          "organization",
          "people",
          "response_due_at",
          "starts_at",
          "status",
          "team",
          "title"
        ],
        "type": "object"
      },
      "PersonalOrganization": {
        "properties": {
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": [
              "string",
              "null"
            ]
          },
          "time_zone": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "role",
          "time_zone"
        ],
        "type": "object"
      },
      "PersonalOverview": {
        "properties": {
          "activities": {
            "items": {
              "$ref": "#/components/schemas/PersonalActivity"
            },
            "type": "array"
          },
          "organizations": {
            "items": {
              "$ref": "#/components/schemas/PersonalOrganization"
            },
            "type": "array"
          },
          "reference_time": {
            "format": "date-time",
            "type": "string"
          },
          "teams": {
