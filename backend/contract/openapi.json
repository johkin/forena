{
  "components": {
    "schemas": {
      "AccessibleInvitation": {
        "properties": {
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "person_id": {
            "format": "uuid",
            "type": "string"
          },
          "response": {
            "enum": [
              "pending",
              "accepted",
              "declined"
            ],
            "type": "string"
          },
          "response_comment": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "person_id",
          "response",
          "response_comment"
        ],
        "type": "object"
      },
      "ApiError": {
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "BrowserLoginRequest": {
        "properties": {
          "email": {
            "maxLength": 320,
            "minLength": 3,
            "type": "string"
          },
          "password": {
            "format": "password",
            "maxLength": 1024,
            "minLength": 1,
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "email",
          "password"
        ],
        "type": "object"
      },
      "BrowserSessionView": {
        "properties": {
          "user": {
            "$ref": "#/components/schemas/BrowserUser"
          }
        },
        "required": [
          "user"
        ],
        "type": "object"
      },
      "BrowserUser": {
        "properties": {
          "email": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "email",
          "id"
        ],
        "type": "object"
      },
      "InvitationResponseResult": {
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "type": "object"
      },
      "MyActivities": {
        "properties": {
          "activities": {
            "items": {
              "$ref": "#/components/schemas/MyActivity"
            },
            "type": "array"
          },
          "next_offset": {
            "format": "int32",
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "activities",
          "next_offset"
        ],
        "type": "object"
      },
      "MyActivity": {
        "properties": {
          "ends_at": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "invitations": {
            "items": {
              "$ref": "#/components/schemas/AccessibleInvitation"
            },
            "type": "array"
          },
          "organization_name": {
            "type": "string"
          },
          "starts_at": {
            "format": "date-time",
            "type": "string"
          },
          "team_name": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "ends_at",
          "id",
          "invitations",
          "organization_name",
          "starts_at",
          "team_name",
          "title"
        ],
        "type": "object"
      },
      "MyInvitations": {
        "properties": {
          "invitations": {
            "items": {
              "$ref": "#/components/schemas/AccessibleInvitation"
            },
            "type": "array"
          }
        },
        "required": [
          "invitations"
        ],
        "type": "object"
      },
      "PasskeyOptions": {
        "properties": {
          "challenge_id": {
            "format": "uuid",
            "type": "string"
          },
          "expires_at": {
            "format": "int64",
            "type": "integer"
          },
          "options": {
            "additionalProperties": true,
            "type": "object"
          }
        },
        "required": [
          "challenge_id",
          "expires_at",
          "options"
        ],
        "type": "object"
      },
      "PasskeyVerifyRequest": {
        "properties": {
          "challenge_id": {
            "format": "uuid",
            "type": "string"
          },
          "credential": {
            "additionalProperties": true,
            "type": "object"
          }
        },
        "required": [
          "challenge_id",
          "credential"
        ],
        "type": "object"
      },
      "RespondToInvitationRequest": {
        "additionalProperties": false,
        "properties": {
          "comment": {
            "description": "Omitted preserves the comment; null or blank clears it. Trimmed and truncated to 500 Unicode code points. Pending always clears it.",
            "type": [
              "string",
              "null"
            ]
          },
          "response": {
            "enum": [
              "pending",
              "accepted",
              "declined"
            ],
            "type": "string"
          }
        },
        "required": [
          "response"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Förena activities API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/activities/{activityId}/my-invitations": {
      "get": {
        "description": "Only own people and active guardian links. Future invitations return an empty list. Cache-Control: no-store.",
        "operationId": "getMyInvitations",
        "parameters": [
          {
            "in": "path",
            "name": "activityId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MyInvitations"
                }
              }
            },
            "description": "Accessible invitations"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Invalid activity UUID"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Missing, invalid, locally inactive or provider-inactive web session"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Activity unavailable to account"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Current Auth session cannot be verified; no fallback"
          }
        },
        "tags": [
          "invitation-controller"
        ]
      }
    },
    "/api/auth/login": {
      "post": {
        "description": "Password sign-in. Requires the canonical Origin and X-Forena-Request: 1. Sets an opaque HttpOnly session cookie; never returns provider tokens.",
        "operationId": "loginBrowserSession",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BrowserLoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/BrowserSessionView"
                }
              }
            },
            "description": "Browser session created"
          },
          "429": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Login admission exhausted; no provider call. Retry later.",
            "headers": {
              "Retry-After": {
                "schema": {
                  "format": "int64",
                  "type": "integer"
                },
                "style": "simple"
              }
            }
          }
        },
        "tags": [
          "browser-session-controller"
        ]
      }
    },
    "/api/auth/logout": {
      "post": {
        "description": "Idempotent local logout. Requires the canonical Origin and X-Forena-Request: 1. Deletes the server session before contacting Auth.",
        "operationId": "logoutBrowserSession",
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "additionalProperties": {
                    "type": "boolean"
                  },
                  "type": "object"
                }
              }
            },
            "description": "OK"
          }
        },
        "tags": [
          "browser-session-controller"
        ]
      }
    },
    "/api/auth/passkey/options": {
      "post": {
        "description": "Begin WebAuthn authentication. Requires the canonical Origin and X-Forena-Request: 1. Binds the challenge to the HttpOnly Spring session for at most five minutes.",
        "operationId": "startBrowserPasskey",
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PasskeyOptions"
                }
              }
            },
            "description": "Browser-bound passkey options"
          },
          "429": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Login admission exhausted; no provider call. Retry later.",
            "headers": {
              "Retry-After": {
                "schema": {
                  "format": "int64",
                  "type": "integer"
                },
                "style": "simple"
              }
            }
          }
        },
        "tags": [
          "browser-session-controller"
        ]
      }
    },
    "/api/auth/passkey/verify": {
      "post": {
        "description": "Verify the browser-bound WebAuthn challenge via Auth and set an HttpOnly session cookie. Requires the canonical Origin and X-Forena-Request: 1. Never returns provider tokens.",
        "operationId": "verifyBrowserPasskey",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasskeyVerifyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/BrowserSessionView"
                }
              }
            },
            "description": "Browser session created"
          },
          "429": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Login admission exhausted; no provider call. Retry later.",
            "headers": {
              "Retry-After": {
                "schema": {
                  "format": "int64",
                  "type": "integer"
                },
                "style": "simple"
              }
            }
          }
        },
        "tags": [
          "browser-session-controller"
        ]
      }
    },
    "/api/auth/session": {
      "get": {
        "description": "Verified user information only. Requires the HttpOnly browser session cookie or an existing valid Bearer token. Cache-Control: no-store.",
        "operationId": "getBrowserSession",
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/BrowserSessionView"
                }
              }
            },
            "description": "OK"
          }
        },
        "tags": [
          "browser-session-controller"
        ]
      }
    },
    "/api/invitations/{invitationId}/respond": {
      "put": {
        "description": "Identical state creates no revision. Concurrent commands serialize in database lock order; a delayed different answer can replace an earlier one. Cache-Control: no-store.",
        "operationId": "respondToInvitation",
        "parameters": [
          {
            "in": "path",
            "name": "invitationId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RespondToInvitationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvitationResponseResult"
                }
              }
            },
            "description": "Committed or unchanged state"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Invalid body or invitation UUID"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Missing, invalid, locally inactive or provider-inactive web session"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Invitation unavailable to account"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Activity cancelled, ended or invitation not sent"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Current Auth session cannot be verified; no fallback"
          }
        },
        "tags": [
          "invitation-controller"
        ]
      }
    },
    "/api/me/activities": {
      "get": {
        "description": "Own and delegated person access. Invitation-backed, ongoing/upcoming scheduled activities starting within 90 days; includes declined and not-yet-sent invitations. Each activity includes only sent invitations for authorized people, with current responses; future invitations remain hidden. Stable starts_at/id order, 50 activities per page, no duplicates. No-store. Offset 0..100000; concurrent changes may shift pages.",
        "operationId": "getMyActivities",
        "parameters": [
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "format": "int32",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MyActivities"
                }
              }
            },
            "description": "My activities"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Invalid offset"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Inactive session"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Session verification unavailable"
          }
        },
        "tags": [
          "activity-overview-controller"
        ]
      }
    }
  },
  "security": [
    {
      "bearer": []
    }
  ],
  "servers": [
    {
      "url": "/"
    }
  ]
}
