# Copy to .env.local in backend/. The local Spring profile reads it automatically.
# This is a Spring properties file: KEY=value, no export or surrounding quotes.
# Do not put real credentials in this example file. .env.local is Git-ignored.

# Optional: first system administrator. Register and verify this account locally.
FORENA_INITIAL_SYSTEM_ADMIN_EMAIL=

# AI Gateway: choose an exact model ID from the Gateway catalog before enabling.
FORENA_ASSISTANT_ENABLED=false
AI_GATEWAY_MODEL=
AI_GATEWAY_API_KEY=

# Use a separate test bot. Local Telegram webhooks need a public HTTPS endpoint.
# The setup script does not read this properties file; see README.md.
FORENA_TELEGRAM_ENABLED=false
FORENA_TELEGRAM_BOT_TOKEN=
FORENA_TELEGRAM_BOT_USERNAME=
FORENA_TELEGRAM_WEBHOOK_SECRET=
FORENA_TELEGRAM_DELIVERY_ENABLED=false

# Voice stays off until the transcription provider's retention is verified.
FORENA_TELEGRAM_VOICE_ENABLED=false
FORENA_TRANSCRIPTION_MODEL=
FORENA_TRANSCRIPTION_RETENTION_VERIFIED=false
