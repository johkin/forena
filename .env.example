# `npm run db:start` and `npm run db:status` print the local values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-or-anon-key
# Server-only secret key used for trusted bootstrap/admin tasks. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=replace-with-supabase-secret-key
SITE_URL=http://localhost:3000
# Server-only participation routing. Keep legacy for the ordinary application.
FORENA_PARTICIPATION_BACKEND=legacy
# Opt-in test only; see docs/migration/browser-participation.md.
# FORENA_KOTLIN_API_URL=http://127.0.0.1:8080
# FORENA_KOTLIN_TEST_ACTIVITY_ID=
# OAuth is opt-in; complete docs/mcp.md setup and live security checks first.
FORENA_MCP_OAUTH_ENABLED=false
# Optional canonical MCP endpoint (must end in /api/mcp). Defaults to SITE_URL/api/mcp.
# Replace the placeholder with the real URL, or leave empty to use the default.
FORENA_MCP_RESOURCE_URL=https://your-forena-domain.example/api/mcp
# Optional exact OAuth issuer, including /auth/v1 for Supabase; not the consent page.
# Defaults to NEXT_PUBLIC_SUPABASE_URL/auth/v1. Must belong to the same Supabase project.
FORENA_MCP_OAUTH_ISSUER_URL=https://your-project-ref.supabase.co/auth/v1
# Comma-separated pre-registered Supabase OAuth client IDs. Server-only.
FORENA_MCP_OAUTH_CLIENT_IDS=replace-with-registered-oauth-client-id

# Optional one-time bootstrap. Only used while no system_admin exists.
FORENA_INITIAL_SYSTEM_ADMIN_EMAIL=admin@example.com
RESEND_API_KEY=replace-with-resend-api-key
RESEND_FROM_EMAIL="Förena <medlem@your-verified-domain.example>"

# Use the same public VAPID key in the web app and notification worker.
# VAPID_PRIVATE_KEY must only be configured as a server-side Supabase secret.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=replace-with-vapid-public-key
VAPID_PUBLIC_KEY=replace-with-the-same-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-vapid-private-key
VAPID_SUBJECT=mailto:admin@example.com

# Vercel AI Gateway uses VERCEL_OIDC_TOKEN automatically in deployments.
# Run `vercel env pull .env.local` to refresh the token for local development.
AI_ENABLED=true
AI_FEED_MODEL=google/gemini-2.5-flash-lite

# Telegram prototype (server only; disabled until tested with a test bot)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# SITE_URL must be the canonical HTTPS origin, also set on notification-worker.

# Private Telegram assistant. Requires the migration and an active Supabase JWT
# signing key as a private JWK (ES256/RS256, or oct HS256 for legacy projects).
# Keep disabled until configured and tested with a separate test bot.
TELEGRAM_ASSISTANT_ENABLED=false
TELEGRAM_ASSISTANT_SIGNING_JWK=
