{
  "name": "forena",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace @forena/frontend",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema public > src/lib/supabase/database.types.ts",
    "prebuild": "node scripts/write-app-version.mjs",
    "frontend:build": "npm run build --workspace @forena/frontend",
    "frontend:dev": "npm run dev --workspace @forena/frontend"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "ai": "7.0.111",
    "next": "16.4.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.5",
    "pngjs": "7.0.0",
    "supabase": "^2.117.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  },
  "workspaces": [
    "frontend"
  ]
}
